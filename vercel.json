{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo Static site in public/, Python API in api/index.py",
  "installCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/((?!waitlist).*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{.venv/**,tests/**,data/**,files/**,docs/**,public/**,dashboard/**,scripts/**,skills/**,.data/**,**/__pycache__/**,*.pdf}"
    }
  }
}
