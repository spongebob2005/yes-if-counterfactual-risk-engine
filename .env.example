# Copy to .env and fill in your PayPal SANDBOX credentials. Never commit .env.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# Order store. Locally, orders go to SQLite; on Vercel, set the Upstash integration's REST URL and token.
# CHECKOUT_DATABASE_PATH=.data/yes-if.sqlite3
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: serve another run's artifacts, e.g. the IEEE-CIS model (default: models/ and reports/ at the repo root).
# RISK_ENGINE_DIR=runs/ieee
